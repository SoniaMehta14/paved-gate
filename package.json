{
  "name": "paved-gate-scripts",
  "private": true,
  "description": "Convenience task runner. Paved Gate itself is a Python package managed with uv; these scripts need uv on PATH and no npm dependencies.",
  "scripts": {
    "test": "uv run pytest",
    "benchmark": "uv run python scripts/benchmark.py",
    "benchmark:dashboard": "uv run python scripts/benchmark.py --open",
    "dashboard": "uv run python scripts/dashboard.py --open",
    "eval:estimate": "uv run python evals/support_tickets/run_eval.py --estimate",
    "eval:dashboard": "uv run python evals/support_tickets/run_eval.py --mock --open"
  }
}
